<div class="container mx-auto px-6 py-8">
<h1 class="text-3xl font-bold mb-6">Your Cart</h1>

<% if @items.empty? %>
  <p>Your cart is empty. <%= link_to "Go shopping", products_path, class: "text-blue-600 hover:underline" %></p>
<% else %>
  <table class="w-full mb-6 border-collapse">
    <thead>
      <tr>
        <th class="text-left p-2 border-b">Product</th>
        <th class="text-left p-2 border-b">Size</th>
        <th class="text-left p-2 border-b">Quantity</th>
        <th class="text-left p-2 border-b">Price</th>
        <th class="p-2 border-b"></th>
      </tr>
    </thead>
    <tbody>
      <% @items.each do |item| %>
        <% v = item[:variant] %>
        <tr>
          <td class="p-2 border-b"><%= v.product.name %></td>
          <td class="p-2 border-b"><%= v.size %></td>
          <td class="p-2 border-b"><%= item[:quantity] %></td>
          <td class="p-2 border-b">$<%= "%.2f" % (v.product.price * item[:quantity]) %></td>
          <td class="p-2 border-b">
            <%= button_to "Remove", line_items_path(variant_id: v.id), method: :delete, class: "text-red-600 hover:underline", form: {style: "display:inline"} %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="flex justify-center items-center space-x-4 mt-6">
    <%= link_to "Continue Shopping", products_path, class: "px-4 py-2 bg-gray-200 rounded hover:bg-gray-300" %>
    <%= link_to "Empty Cart", cart_path, method: :delete, data: { confirm: "Are you sure?" }, class: "px-4 py-2 bg-red-500 text-white rounded hover:bg-red-600" %>
    <%= link_to "Checkout", checkout_path, class: "px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700" %>
  </div>
<% end %>
</div>
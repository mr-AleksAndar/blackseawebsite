<!DOCTYPE html>
<html lang="bg">
  <head>
    <title>Surf Black Sea</title>
    <meta http-equiv="Content-Language" content="bg">
    <meta name="description" content="Explore the best surf spots on the Black Sea coast. Stay updated with the latest surf conditions, locations, and tips. Surf Black Sea offers a guide for both beginners and pros!">
    <meta name="keywords" content="surf, Black Sea, Bulgaria surf, surf spots, surfing guide, waves, surfing conditions">
    <meta name="author" content="Surf Black Sea">
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <meta property="og:title" content="Surf Black Sea - Discover the Best Surf Spots in Bulgaria">
    <meta property="og:description" content="Find the perfect surf spot along the Black Sea coast. Surf Black Sea provides real-time surf conditions and detailed spot guides.">
    <meta property="og:image" content="<%= asset_path('club_banner.webp') %>"> 
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:type" content="website">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Surf Black Sea - Discover Surf Spots">
    <meta name="twitter:description" content="Explore and surf the Black Sea with our complete guide to surf spots in Bulgaria.">
    <meta name="twitter:image" content="<%= asset_path('club_banner.webp') %>">
    
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-EJ6C9PDJVJ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-EJ6C9PDJVJ');
    </script>

    <%= yield :head %>
    <%= tag.link rel: "canonical", href: (content_for?(:canonical) ? yield(:canonical) : canonical_url) %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= favicon_link_tag asset_path('water-waves.webp'), rel: 'icon', type: 'image/png', sizes: '32x32' %>
    <%= favicon_link_tag asset_path('water-waves.webp'), rel: 'icon', type: 'image/png', sizes: '16x16' %>
    <%= favicon_link_tag asset_path('water-waves.webp'), rel: 'apple-touch-icon', sizes: '180x180' %>
    <script src="https://cdn.jsdelivr.net/npm/flowbite@latest/dist/flowbite.min.js"></script>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= javascript_include_tag "navbar", "data-turbo-track": "reload" %>

    <!-- Google Translate Script & Logic -->
    <script type="text/javascript">
      function googleTranslateElementInit() {
        new google.translate.TranslateElement({
          pageLanguage: 'bg',
          includedLanguages: 'en,bg',
          autoDisplay: false
        }, 'google_translate_element');
      }

      function getTranslateCookie() {
        var name = "googtrans=";
        var decodedCookie = decodeURIComponent(document.cookie);
        var ca = decodedCookie.split(';');
        for(var i = 0; i <ca.length; i++) {
          var c = ca[i].trim();
          if (c.indexOf(name) == 0) return c.substring(name.length, c.length);
        }
        return "";
      }

      function setTranslateCookie(lang) {
        var value = lang ? "/bg/" + lang : "";
        var domain = window.location.hostname;
        // Set for both the current domain and the base domain to be safe
        document.cookie = "googtrans=" + value + "; path=/; SameSite=Lax";
        // Also set for .domain to cover subdomains if any
        document.cookie = "googtrans=" + value + "; path=/; domain=." + domain + "; SameSite=Lax";
      }

      function triggerTranslation() {
        var current = getTranslateCookie();
        var isEn = current.indexOf('/en') !== -1;
        
        if (isEn) {
          setTranslateCookie(""); // Clear for Bulgarian
        } else {
          setTranslateCookie("en");
        }
        
        // Reload is the only 100% reliable way to make Google Translate 
        // re-scan the Turbo-replaced DOM and persist the state.
        window.location.reload();
      }

      function updateFlagIcon() {
        var current = getTranslateCookie();
        var isEn = current.indexOf('/en') !== -1;
        
        document.querySelectorAll('.lang-flag-btn').forEach(function(btn) {
          if (isEn) {
            btn.textContent = '\uD83C\uDDE7\uD83C\uDDEC'; // BG flag
            btn.setAttribute('title', '\u041f\u0440\u0435\u0432\u0435\u0434\u0438 \u043d\u0430 \u0411\u044a\u043b\u0433\u0430\u0440\u0441\u043a\u0438');
          } else {
            btn.textContent = '\uD83C\uDDEC\uD83C\uDDE7'; // EN flag
            btn.setAttribute('title', 'Translate to English');
          }
        });
      }

      document.addEventListener('turbo:load', function() {
        updateFlagIcon();
        // If Google Translate bar appears, hide it again
        var checkBar = setInterval(function() {
          var bar = document.querySelector('.goog-te-banner-frame');
          if (bar) {
            bar.style.display = 'none';
            document.body.style.top = '0px';
          }
        }, 500);
        setTimeout(function() { clearInterval(checkBar); }, 5000);
      });

      window.addEventListener('load', updateFlagIcon);
    </script>
    <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
    <style>
      /* Hide Google UI trash */
      #google_translate_element, .skiptranslate, .goog-te-banner-frame, #goog-gt-tt, .goog-te-balloon-frame { 
        display: none !important; 
      }
      body { top: 0 !important; position: static !important; }
      .goog-text-highlight { background: none !important; box-shadow: none !important; }
    </style>
  </head>

  <body>
    <%= render 'layouts/header' %> 
    <%= yield %>
  </body>
</html>

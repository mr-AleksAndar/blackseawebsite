<!-- app/views/products/index.html.erb -->
<h1 class="text-4xl font-bold mb-6">Shop</h1>

<!-- Tag Filters (same as before) -->
<div class="mb-6 flex flex-wrap gap-2">
  <%= link_to "All", products_path,
       class: "px-3 py-1 border rounded #{params[:tag].blank? ? 'bg-gray-800 text-white' : ''}" %>
  <% @tags.each do |tag| %>
    <%= link_to tag.name, products_path(tag: tag.name),
         class: "px-3 py-1 border rounded #{params[:tag] == tag.name ? 'bg-gray-800 text-white' : ''}" %>
  <% end %>
</div>

<!-- Product Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
  <% @products.each do |product| %>
    <%= render "products/card", product: product %>
  <% end %>
</div>
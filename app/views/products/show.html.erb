<%# app/views/products/show.html.erb %>
<div class="max-w-3xl mx-auto p-6">
  <h1 class="text-3xl font-bold mb-4"><%= @product.name %></h1>
  <p class="text-gray-700 mb-6"><%= @product.description %></p>

  <!-- Product Image -->
  <% if @product.image_asset_url %>
    <img src="<%= @product.image_asset_url %>"
         alt="<%= @product.name %>"
         class="w-full h-64 object-cover rounded mb-6" />
  <% end %>

  <p class="text-2xl font-semibold mb-6">$<%= "%.2f" % @product.price %></p>

  <h3 class="text-xl font-semibold mb-2">Available Sizes</h3>
  <%= form_with url: line_items_path, method: :post, local: true do |f| %>
    <%= f.hidden_field :product_id, value: @product.id %>

    <!-- Variant Selector -->
    <div class="mb-4">
      <%= f.label :variant_id, "Choose Size", class: "block mb-1 font-medium" %>
      <%= f.select :variant_id,
            options_from_collection_for_select(@variants, :id, :size_with_stock),
            {}, # no html options
            class: "w-full border rounded p-2" %>
    </div>

    <!-- Quantity -->
    <div class="mb-6">
      <%= f.label :quantity, "Quantity", class: "block mb-1 font-medium" %>
      <%= f.number_field :quantity, value: 1, min: 1,
            class: "w-24 border rounded p-2" %>
    </div>

    <!-- Submit Button -->
    <%= f.submit "Add to Cart",
          class: "w-full bg-blue-500 text-white py-2 rounded hover:bg-blue-600 transition" %>
  <% end %>
</div>
<div class="border rounded-lg overflow-hidden shadow hover:shadow-lg transition">
  <%= link_to product_path(product), class: "block" do %>
    <% if product.image_url.present? %>
      <img src="<%= product.image_url %>"
           alt="<%= product.name %>"
           class="w-full h-48 object-cover">
    <% end %>
    <div class="p-4 flex flex-col h-full">
      <h2 class="text-xl font-semibold mb-2"><%= product.name %></h2>
      <p class="text-gray-600 mb-2"><%= truncate(product.description, length: 80) %></p>

      <% if product.variants.any? %>
        <div class="mb-4">
          <strong>Sizes:</strong>
          <div class="flex flex-wrap gap-2 mt-1">
            <% product.variants.each do |v| %>
              <span
                class="inline-block px-2 py-1 rounded text-sm
                  <%= v.stock > 0 ? 'bg-green-200 text-green-800' : 'bg-gray-200 text-gray-500' %>">
                <%= v.size %>
                (<%= v.stock %>)
              </span>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="mt-auto">
        <p class="font-bold text-lg mb-2">$<%= "%.2f" % product.price %></p>
        <a href="<%= product_path(product) %>"
           class="block text-center px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600">
          View Details
        </a>
      </div>
    </div>
  <% end %>
</div>
<% content_for :head do %>
  <title>Wake & Surf Club Varna - Join the Ultimate Watersport Community</title>
  <meta name="description" content="Welcome to Wake & Surf Club Varna, the Black Sea’s top destination for surfing, wakeboarding, and more. Join our vibrant community of water sports lovers!">
  <meta name="keywords" content="Wake & Surf Club Varna, surfing, wakeboarding, Black Sea, water sports, community, Bulgaria">
  <meta name="author" content="Wake & Surf Club Varna">
  
  <!-- Open Graph Meta Tags -->
  <meta property="og:title" content="Wake & Surf Club Varna - The Ultimate Destination for Water Lovers">
  <meta property="og:description" content="Explore the best of the Black Sea at Wake & Surf Club Varna, a paradise for surfers and wakeboarders alike.">
  <meta property="og:image" content="<%= asset_path('club_banner.webp') %>">
  <meta property="og:url" content="<%= request.original_url %>">
  <meta property="og:type" content="website">
  
  <!-- Twitter Meta Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Join Wake & Surf Club Varna">
  <meta name="twitter:description" content="Be part of a passionate watersport community at the Black Sea’s premier surf club.">
  <meta name="twitter:image" content="<%= asset_path('club_banner.webp') %>">

<% end %>

<!-- Hero Banner -->
<div class="relative w-full bg-cover bg-center h-48 sm:h-64 md:h-80 lg:h-96 xl:h-[500px] 2xl:h-[700px] 3xl:h-[900px]" 
     style="background-image: url('<%= asset_path("club_banner.webp") %>');">
</div>

<!-- Introduction Section -->
<div class="container mx-auto px-6 py-8">
  <h2 class="text-3xl font-bold text-center mb-6">Добре дошли!</h2>
  <p class="text-lg text-gray-700 text-center mb-4">
    Уейк & Сърф Клуб Варна е крайната дестинация за любителите на водните спортове! Независимо дали сте сърфист, уейкбордист, или просто обичате морето, нашият клуб е идеалното място да се насладите на красивото Черно море в добра компания.
  </p>
</div>

<!-- Membership Section -->
<div class="container mx-auto px-6 py-8 bg-blue-100 rounded-lg text-center shadow-md">
  <h3 class="text-2xl font-bold mb-4">Станете Член</h3>
  <p class="text-lg text-gray-700 mb-6">
    Интересувате ли се от клуба? Попълнете формуляра и научете повече за всички събития и предимства за членовете!
  </p>
  <a href="https://forms.gle/d97rkqAn7Z2ek3Tq6" target="_blank" class="inline-block px-6 py-3 bg-blue-500 text-white font-bold rounded-md hover:bg-blue-600 transition duration-300">
    Запишете се сега!
  </a>
</div>

<!-- Social Media Section -->
<div class="container mx-auto px-6 py-8 text-center">
  <h3 class="text-2xl font-bold mb-4">Последвайте ни!</h3>
  <div class="flex justify-center items-center mt-4">
    <!-- Facebook -->
    <a href="https://www.facebook.com/profile.php?id=61561584917542"
       target="_blank" rel="noopener">
      <img src="/assets/facebook.svg"
           alt="Facebook"
           style="width:60px; height:60px; object-fit:contain; margin-right:24px; cursor:pointer; transition:opacity .2s;"
           onmouseover="this.style.opacity=0.75"
           onmouseout="this.style.opacity=1" />
    </a>

    <!-- Instagram -->
    <a href="https://www.instagram.com/wakesurfclubvarna"
       target="_blank" rel="noopener">
      <img src="/assets/instagram.svg"
           alt="Instagram"
           style="width:60px; height:60px; object-fit:contain; cursor:pointer; transition:opacity .2s;"
           onmouseover="this.style.opacity=0.75"
           onmouseout="this.style.opacity=1" />
    </a>
  </div>
</div>
<!-- Footer Section -->
<footer class="bg-gray-800 text-white py-6">
  <div class="container mx-auto px-6 text-center">
    <p>&copy; <%= Time.now.year %> Wake & Surf Club Varna. All rights reserved.</p>
  </div>
</footer>